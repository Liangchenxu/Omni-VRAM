# 忽略编译产生的文件
build/
dist/
*.egg-info/
*.pyd
*.obj
*.o
*.whl

# 忽略测试缓存
.pytest_cache/

# 忽略 Python 缓存
__pycache__/
*.pyc

# 忽略临时测试脚本 (可选，如果你不想公开测试脚本可以取消注释)
# test_run.py

# 敏感配置文件
.env
.env.local
.env.production
# .env.example 不忽略，作为模板提交

# IDE配置
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db

# 任务执行报告 (由 .clinerules 常驻输出规范自动生成，每次覆盖写入)
result.txt